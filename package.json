    "lint": "npm run lint -w @altio/web",
    "typecheck": "npm run typecheck -w @altio/web",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "overrides": {
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
