{
  "name": "@altio/web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "build:export": "cross-env NEXT_OUTPUT=export node ./node_modules/next/dist/bin/next build && node scripts/fix-rsc-paths.mjs",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "check:site": "node scripts/check-site-data.mjs",
    "check:release": "node scripts/check-site-data.mjs --strict",
    "seo:lint": "node scripts/seo-lint.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "build:release": "npm run check:release && node scripts/optimize-images.mjs --check && npm run build:export && npm run seo:lint",
    "lighthouse": "node scripts/lighthouse.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:export && npm run seo:lint",
    "og": "node scripts/generate-og.mjs",
    "e2e:admin": "cross-env E2E_ADMIN=1 playwright test",
    "claims": "node scripts/claims-audit.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "chrome-launcher": "^1.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "sass": "^1.105.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
