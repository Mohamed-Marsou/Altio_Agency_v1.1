# Copy this file to .env.local (git ignores .env.local). Every line is optional.

# Dashboard password, as a one-way fingerprint. Do NOT write the password here:
# run `npm run admin:password` and it writes this line for you.
ADMIN_PASSWORD_HASH=

# Public address of the site (sitemap, canonical links, social cards).
# NEXT_PUBLIC_SITE_URL=https://yourdomain.ma

# Set to off to remove the intro loading screen (better speed score).
# NEXT_PUBLIC_SITE_LOADER=off
