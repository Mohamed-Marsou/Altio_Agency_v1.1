# Copy this file to .env and fill it in. .env is ignored by git: never commit secrets.

NODE_ENV=development
PORT=4000

# The front-ends allowed to call the API (CORS allow-list)
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# PostgreSQL (local Docker, or a managed one such as Neon or Supabase)
# DATABASE_URL=postgresql://altio:altio@localhost:5432/altio?schema=public

# Coming with the auth module:
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# COOKIE_DOMAIN=
