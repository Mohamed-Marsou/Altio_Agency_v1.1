{
  "name": "@altio/api",
  "version": "0.1.0",
  "private": true,
  "description": "Altio backend: Express 5 API (leads, content, admin, analytics). Built after the website launch.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "db:validate": "node ./node_modules/prisma/build/index.js validate",
    "db:format": "node ./node_modules/prisma/build/index.js format",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  }
}
